<Window x:Class="ExamBuilder.App.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول — مُنشئ الامتحانات"
        Height="560" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource Ground}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- نموذج الدخول -->
    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="48,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
        <Border Background="{StaticResource Teal}" CornerRadius="10" Width="42" Height="42">
          <TextBlock Text="م" Foreground="White" FontSize="20" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="مُنشئ الامتحانات" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
          <TextBlock Text="الإصدار المكتبي" FontSize="11" Foreground="{StaticResource Muted}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="مرحباً بعودتك" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
      <TextBlock Text="سجّل الدخول إلى مساحة عملك." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />

      <TextBlock Text="البريد الإلكتروني" FontSize="12.5" FontWeight="SemiBold"
                 Foreground="{StaticResource InkSoft}" Margin="0,24,0,6" />
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
        <TextBox x:Name="EmailBox" Text="maryam@moe.gov" BorderThickness="0" Background="Transparent"
                 Padding="13,11" FontSize="14" VerticalContentAlignment="Center" />
      </Border>

      <TextBlock Text="كلمة المرور" FontSize="12.5" FontWeight="SemiBold"
                 Foreground="{StaticResource InkSoft}" Margin="0,16,0,6" />
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
        <PasswordBox x:Name="PasswordBox" BorderThickness="0" Background="Transparent"
                     Padding="13,11" FontSize="14" VerticalContentAlignment="Center" />
      </Border>

      <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="12.5" Margin="0,10,0,0"
                 Visibility="Collapsed" TextWrapping="Wrap" />

      <Button x:Name="LoginButton" Content="تسجيل الدخول" Style="{StaticResource PrimaryButton}"
              Margin="0,22,0,0" Padding="16,13" FontSize="15" Click="LoginButton_Click" IsDefault="True" />

      <TextBlock Text="بيانات تجريبية: maryam@moe.gov / 123456" FontSize="11"
                 Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,18,0,0" />
    </StackPanel>

    <!-- لوحة العلامة -->
    <Border Grid.Column="1" Background="{StaticResource Sidebar}">
      <StackPanel VerticalAlignment="Center" Margin="56,0">
        <TextBlock Text="أعدّ امتحاناتك المدرسية بتنسيق احترافي آلي" Foreground="White"
                   FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="40" />
        <TextBlock Text="منصّة مكتبية متكاملة لبناء أوراق الأسئلة ونماذج الإجابة، وتصديرها إلى Word و PDF و Excel بضغطة واحدة."
                   Foreground="#9FC9BD" FontSize="14" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="26" />
        <StackPanel Margin="0,28,0,0">
          <TextBlock Text="•  دعم المعادلات والآيات القرآنية بالرسم العثماني" Foreground="#CFE1DB" FontSize="14" Margin="0,0,0,12" />
          <TextBlock Text="•  بناء الأسئلة الموضوعية ونموذج الإجابة آلياً" Foreground="#CFE1DB" FontSize="14" Margin="0,0,0,12" />
          <TextBlock Text="•  تصدير فوري إلى Word و PDF و مفتاح إجابة Excel" Foreground="#CFE1DB" FontSize="14" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
