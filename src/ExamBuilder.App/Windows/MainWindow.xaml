<Window x:Class="ExamBuilder.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مُنشئ الامتحانات"
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource Ground}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- شريط علوي -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="20,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="{StaticResource Teal}" CornerRadius="9" Width="34" Height="34">
            <TextBlock Text="م" Foreground="White" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="مُنشئ الامتحانات" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
            <TextBlock Text="الإصدار المكتبي · يعمل دون اتصال" FontSize="11" Foreground="{StaticResource Muted}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding RoleName}" FontSize="11" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Left" />
          </StackPanel>
          <Border Background="{StaticResource Amber}" CornerRadius="17" Width="34" Height="34">
            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- الجسم -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- القائمة الجانبية -->
      <Border Grid.Column="0" Background="{StaticResource Sidebar}">
        <StackPanel Margin="14,16">
          <TextBlock Text="مساحة العمل" Foreground="{StaticResource SidebarMuted}" FontSize="11"
                     FontWeight="SemiBold" Margin="10,0,10,8" />
          <ItemsControl ItemsSource="{Binding WorkspaceItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource SidebarItem}"
                        Content="{Binding Label}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Key}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="الإدارة" Foreground="{StaticResource SidebarMuted}" FontSize="11"
                     FontWeight="SemiBold" Margin="10,14,10,8" />
          <ItemsControl ItemsSource="{Binding AdminItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource SidebarItem}"
                        Content="{Binding Label}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Key}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- منطقة المحتوى -->
      <ContentControl Grid.Column="1" Content="{Binding Current}" />
    </Grid>
  </Grid>
</Window>
