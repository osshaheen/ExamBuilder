<UserControl x:Class="ExamBuilder.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}"
             Background="{StaticResource Ground}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30">
      <TextBlock Text="لوحة التحكم" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
      <TextBlock Text="نظرة عامة على الامتحانات والأسئلة في النظام." FontSize="13"
                 Foreground="{StaticResource Muted}" Margin="0,4,0,0" />

      <UniformGrid Rows="1" Columns="4" Margin="0,20,0,0">
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="{Binding ExamCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Teal}" />
            <TextBlock Text="امتحان" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="{Binding QuestionCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
            <TextBlock Text="سؤال" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="{Binding SubjectCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
            <TextBlock Text="مادة دراسية" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding UserCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
            <TextBlock Text="مستخدم" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <TextBlock Text="أحدث الامتحانات" FontSize="16" FontWeight="SemiBold"
                 Foreground="{StaticResource Ink}" Margin="0,26,0,12" />

      <ItemsControl ItemsSource="{Binding RecentExams}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                  <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource TealTint}" CornerRadius="20"
                        Padding="11,4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                             Foreground="{StaticResource TealDeep}" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
