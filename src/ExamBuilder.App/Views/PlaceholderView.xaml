<UserControl x:Class="ExamBuilder.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}"
             Background="{StaticResource Ground}">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
    <Border Background="{StaticResource TealTint}" CornerRadius="16" Width="64" Height="64"
            HorizontalAlignment="Center">
      <TextBlock Text="✦" FontSize="28" Foreground="{StaticResource Teal}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
               HorizontalAlignment="Center" Margin="0,16,0,0" />
    <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource Muted}"
               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
    <Border Background="#F6EBDC" CornerRadius="20" Padding="12,5" HorizontalAlignment="Center" Margin="0,16,0,0">
      <TextBlock Text="هذه الشاشة قيد الإنشاء" FontSize="12" FontWeight="SemiBold" Foreground="#9A5B18" />
    </Border>
  </StackPanel>
</UserControl>
