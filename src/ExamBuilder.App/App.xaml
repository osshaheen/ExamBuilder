<Application x:Class="ExamBuilder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ExamBuilder.App.ViewModels"
             xmlns:views="clr-namespace:ExamBuilder.App.Views">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <views:PlaceholderView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
